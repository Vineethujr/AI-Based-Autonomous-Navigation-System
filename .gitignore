# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Results and assets generated at runtime (keep directories via .gitkeep)
results/*
!results/.gitkeep
assets/*
!assets/.gitkeep

